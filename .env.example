# Google Cloud Project Configuration (Never commit raw API keys; secrets are loaded via Secret Manager)
GOOGLE_CLOUD_PROJECT=your-gcp-project-id
GOOGLE_CLOUD_LOCATION=us-east4
GOOGLE_GENAI_USE_VERTEXAI=TRUE

# Secret Manager Secret IDs (fetched at runtime by app/secrets.py)
MEDOPS_PAGERDUTY_WEBHOOK_SECRET_ID=medops-pagerduty-webhook-token
MEDOPS_EHR_API_TOKEN_SECRET_ID=medops-ehr-fhir-api-token
MEDOPS_HITL_SIGNING_KEY_SECRET_ID=medops-hitl-signing-secret

# Firestore Collections
MEDOPS_DEVICES_COLLECTION=medical_devices
MEDOPS_TICKETS_COLLECTION=biomed_tickets
MEDOPS_TRIAGE_COLLECTION=clinical_triage_records
MEDOPS_SESSIONS_COLLECTION=medops_sessions
MEDOPS_MEMORIES_COLLECTION=medops_memories
MEDOPS_HITL_COLLECTION=hitl_approval_requests

# Model Armor & Observability Settings
MEDOPS_MODEL_ARMOR_TEMPLATE_ID=projects/your-gcp-project-id/locations/us-east4/templates/medops-strict-armor
MEDOPS_ENABLE_CLOUD_TRACE=true
MEDOPS_ENABLE_CLOUD_DLP=false
